# Copy this file to .env, paste your actual keys, and restart run_windows.bat
# Google AI Studio: https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Geoapify Projects: https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=
# Use auto: app tries Flash-Lite first, then other available Flash models on overload.
# You may enter a specific model ID instead.
GEMINI_MODEL=auto
